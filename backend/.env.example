# Database connection (ใช้ค่าจาก MySQL ที่ติดตั้งหรือผู้ให้บริการฐานข้อมูล)
DATABASE_HOST=localhost
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=resume_analysis
# พอร์ต MySQL (ค่าเริ่มต้นทั่วไปคือ 3306)
DATABASE_PORT=3306

# Secret สำหรับเซ็นและตรวจสอบ JWT (ตั้งค่าเป็นสตริงสุ่มที่เดายาก)
JWT_TOKEN=

# Cloudinary Dashboard > Settings > Product environment credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI service ที่ backend เรียกใช้สำหรับวิเคราะห์ข้อมูล
# ถ้าเว้นว่าง ระบบจะใช้ค่า default ที่กำหนดไว้ใน backend/service/applicant.js
AI_SERVICE_TOKEN=
AI_SERVICE_URL=
